# Secrets — never commit, in any commit, ever
.env
*.key
*api_key*
*secret*

# Dataset media — datasets enter this repo only as download scripts,
# a clip manifest, and checksums. No media files, ever.
data/
board_assets/
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Caches and run artifacts (regenerable)
cache/
__pycache__/
*.pyc
.pytest_cache/

# OS noise
.DS_Store

# check byproducts (regenerated deterministically)
tests/fixtures/overlay_roundtrip.png
tests/fixtures/attr_frame.png
tests/fixtures/picker_frame_*.png
tests/fixtures/picker_out_*.png
!tests/fixtures/tiny.mp4
.venv/
